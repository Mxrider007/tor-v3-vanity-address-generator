// torv3-vanity GPU kernel.
//
// Field elements of GF(2^255 - 19) are 20 limbs of 13 bits (260 bits), so
// that a product of two limbs (< 2^26.1) summed twenty times still fits in a
// u32. Limb bounds maintained by every function below:
//   * limbs 0..=18 are < 8256 and limb 19 is < 512 ("carried" form);
//   * fe_mul / fe_sq accept carried inputs and return carried outputs.
// `G`, `fe_mul`, `fe_sq`, `fe_carry`, `fe_pack`, `fe_unpack` and
// `table_entry` are generated by shader.rs and prepended/appended to this
// file.
//
// Each invocation owns one "center" point and, per group, visits the keys
// center ± i·8B (i = 1..=G) plus the center itself, exactly like the CPU
// walker in src/curve/walk.rs. Only y is computed; candidates are reported
// as (invocation, group, index) and verified on the CPU.

alias Fe = array<u32, 20>;
alias Packed = array<u32, 8>;

const M: u32 = 0x1fffu;
const KEYS_PER_GROUP: u32 = 2u * G + 1u;
const MAX_HITS: u32 = 1024u;

struct Params {
    groups: u32,
    threads: u32,
    filter_count: u32,
    filter_words: u32,
}

@group(0) @binding(0) var<uniform> params: Params;
// (G + 1) entries of x, y and e = d·x·y (20 limbs each): i·8B for i = 1..=G,
// then the step (2G + 1)·8B to the next center.
@group(0) @binding(1) var<storage, read> table: array<u32>;
// Per filter: 8 mask words then 8 value words over the packed y coordinate.
@group(0) @binding(2) var<storage, read> filters: array<u32>;
// Per invocation: packed x then packed y of its current center.
@group(0) @binding(3) var<storage, read_write> centers: array<u32>;
// hits[0] = number of hits; then (invocation, group, index) triples.
@group(0) @binding(4) var<storage, read_write> hits: array<atomic<u32>>;

fn fe_one() -> Fe {
    var r: Fe;
    r[0] = 1u;
    return r;
}

fn fe_add(a: Fe, b: Fe) -> Fe {
    var r: Fe;
    for (var i = 0u; i < 20u; i++) {
        r[i] = a[i] + b[i];
    }
    return fe_carry(r);
}

// a - b computed as a + 4p - b so every limb stays non-negative.
fn fe_sub(a: Fe, b: Fe) -> Fe {
    var r: Fe;
    r[0] = a[0] + 32692u - b[0];
    for (var i = 1u; i < 19u; i++) {
        r[i] = a[i] + 32764u - b[i];
    }
    r[19] = a[19] + 1020u - b[19];
    return fe_carry(r);
}

fn fe_sqn(a: Fe, n: u32) -> Fe {
    var r = a;
    for (var i = 0u; i < n; i++) {
        r = fe_sq(r);
    }
    return r;
}

// z^(p - 2), the same addition chain as the CPU code.
fn fe_inv(z: Fe) -> Fe {
    let z2 = fe_sq(z);
    let z9 = fe_mul(fe_sqn(z2, 2u), z);
    let z11 = fe_mul(z9, z2);
    let z2_5_0 = fe_mul(fe_sq(z11), z9);
    let z2_10_0 = fe_mul(fe_sqn(z2_5_0, 5u), z2_5_0);
    let z2_20_0 = fe_mul(fe_sqn(z2_10_0, 10u), z2_10_0);
    let z2_40_0 = fe_mul(fe_sqn(z2_20_0, 20u), z2_20_0);
    let z2_50_0 = fe_mul(fe_sqn(z2_40_0, 10u), z2_10_0);
    let z2_100_0 = fe_mul(fe_sqn(z2_50_0, 50u), z2_50_0);
    let z2_200_0 = fe_mul(fe_sqn(z2_100_0, 100u), z2_100_0);
    let z2_250_0 = fe_mul(fe_sqn(z2_200_0, 50u), z2_50_0);
    return fe_mul(fe_sqn(z2_250_0, 5u), z11);
}

// Carry without folding: limbs 0..=18 end up < 2^13.
fn fe_propagate(a: Fe) -> Fe {
    var r = a;
    for (var i = 0u; i < 19u; i++) {
        r[i + 1u] += r[i] >> 13u;
        r[i] &= M;
    }
    return r;
}

// The fully reduced value (0 <= v < p) as eight little-endian 32-bit words.
fn fe_canonical(a: Fe) -> Packed {
    // Strict limbs and v < 2^255 + 19.
    var r = fe_propagate(fe_carry(a));
    let hi = r[19] >> 8u;
    r[19] &= 0xffu;
    r[0] += 19u * hi;
    r = fe_propagate(r);
    // q = 1 iff v >= p, i.e. iff v + 19 >= 2^255.
    var c = (r[0] + 19u) >> 13u;
    for (var i = 1u; i < 19u; i++) {
        c = (r[i] + c) >> 13u;
    }
    let q = (r[19] + c) >> 8u;
    r[0] += 19u * q;
    r = fe_propagate(r);
    r[19] &= 0xffu;
    return fe_pack(r);
}

fn load_center(base: u32) -> Packed {
    var p: Packed;
    for (var i = 0u; i < 8u; i++) {
        p[i] = centers[base + i];
    }
    return p;
}

fn store_center(base: u32, p: Packed) {
    for (var i = 0u; i < 8u; i++) {
        centers[base + i] = p[i];
    }
}

fn is_candidate(y: Packed) -> bool {
    for (var f = 0u; f < params.filter_count; f++) {
        var ok = true;
        for (var w = 0u; w < params.filter_words; w++) {
            if ((y[w] & filters[f * 16u + w]) != filters[f * 16u + 8u + w]) {
                ok = false;
                break;
            }
        }
        if (ok) {
            return true;
        }
    }
    return false;
}

fn report(y: Fe, invocation: u32, group: u32, index: u32) {
    if (is_candidate(fe_canonical(y))) {
        let slot = atomicAdd(&hits[0], 1u);
        if (slot < MAX_HITS) {
            atomicStore(&hits[1u + 3u * slot], invocation);
            atomicStore(&hits[2u + 3u * slot], group);
            atomicStore(&hits[3u + 3u * slot], index);
        }
    }
}

@compute @workgroup_size(64)
fn search(@builtin(global_invocation_id) gid: vec3<u32>) {
    let t = gid.x;
    if (t >= params.threads) {
        return;
    }
    var x1 = fe_unpack(load_center(t * 16u));
    var y1 = fe_unpack(load_center(t * 16u + 8u));
    var t1 = fe_mul(x1, y1);
    let one = fe_one();
    // Prefix products of the denominators, packed to save memory.
    var pre: array<Packed, 2u * G + 2u>;

    for (var g = 0u; g < params.groups; g++) {
        // Forward pass: denominators 1 - k and 1 + k with k = t1·e.
        var acc = one;
        for (var i = 0u; i < G; i++) {
            let k = fe_mul(t1, table_entry(i, 2u));
            pre[2u * i] = fe_pack(fe_propagate(acc));
            acc = fe_mul(acc, fe_sub(one, k));
            pre[2u * i + 1u] = fe_pack(fe_propagate(acc));
            acc = fe_mul(acc, fe_add(one, k));
        }
        let kr = fe_mul(t1, table_entry(G, 2u));
        let dp_r = fe_sub(one, kr);
        let dm_r = fe_add(one, kr);
        pre[2u * G] = fe_pack(fe_propagate(acc));
        acc = fe_mul(acc, dp_r);
        pre[2u * G + 1u] = fe_pack(fe_propagate(acc));
        acc = fe_mul(acc, dm_r);

        // Backward pass: peel off one inverse at a time.
        var inv = fe_inv(acc);
        let inv_dm_r = fe_mul(inv, fe_unpack(pre[2u * G + 1u]));
        inv = fe_mul(inv, dm_r);
        let inv_dp_r = fe_mul(inv, fe_unpack(pre[2u * G]));
        inv = fe_mul(inv, dp_r);
        for (var j = 0u; j < G; j++) {
            let i = G - 1u - j;
            let xx = fe_mul(x1, table_entry(i, 0u));
            let yy = fe_mul(y1, table_entry(i, 1u));
            let k = fe_mul(t1, table_entry(i, 2u));
            let inv_dm = fe_mul(inv, fe_unpack(pre[2u * i + 1u]));
            inv = fe_mul(inv, fe_add(one, k));
            let inv_dp = fe_mul(inv, fe_unpack(pre[2u * i]));
            inv = fe_mul(inv, fe_sub(one, k));
            // y(P + Q_i) = (yy + xx) / (1 - k),  y(P - Q_i) = (yy - xx) / (1 + k)
            report(fe_mul(fe_add(yy, xx), inv_dp), t, g, 2u * i + 1u);
            report(fe_mul(fe_sub(yy, xx), inv_dm), t, g, 2u * i + 2u);
        }
        report(y1, t, g, 0u);

        // Next center: P + R.
        let rx = table_entry(G, 0u);
        let ry = table_entry(G, 1u);
        let ny = fe_mul(fe_add(fe_mul(y1, ry), fe_mul(x1, rx)), inv_dp_r);
        let nx = fe_mul(fe_add(fe_mul(x1, ry), fe_mul(y1, rx)), inv_dm_r);
        x1 = nx;
        y1 = ny;
        t1 = fe_mul(x1, y1);
    }

    store_center(t * 16u, fe_canonical(x1));
    store_center(t * 16u + 8u, fe_canonical(y1));
}
